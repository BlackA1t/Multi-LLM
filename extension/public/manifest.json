{
  "manifest_version": 3,
  "name": "Multi-LLM Research",
  "version": "0.1.0",
  "description": "Локальное управление исследовательскими сессиями Multi-LLM.",
  "permissions": ["sidePanel", "nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Открыть Multi-LLM",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
